APP_NAME="IVESS Conecta 4.0"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ivess_conecta
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Inertia: sin servidor SSR
INERTIA_SSR_ENABLED=false

# ── Telemetría ─────────────────────────────────────────────
TELEMETRY_DISPLAY_TZ=America/Argentina/Buenos_Aires
TELEMETRY_GATEWAY_TZ=America/Argentina/Buenos_Aires
TELEMETRY_POLL_SECONDS=30
TELEMETRY_RAW_DAYS=120
TELEMETRY_CIP_EXPIRED_STATUS=alarma

# Broker MQTT (php artisan telemetry:listen)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=ivess-ingestor
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TLS_CA_FILE=
MQTT_TOPIC_PREFIX=ivess
MQTT_QOS=1
MQTT_CLEAN_SESSION=false

# API REST Exemys M2M (php artisan exemys:fetch)
EXEMYS_BASE_URL=https://m2m.exemys.com/api/v1
EXEMYS_USERNAME=
EXEMYS_PASSWORD=
EXEMYS_UNIT_ID=

VITE_APP_NAME="${APP_NAME}"
